# Django CMS backend (backend). No trailing slash, no /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site. Used as metadataBase until SiteSettings.seoDefaults.siteUrl is set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the CMS cache-refresh webhook (src/app/api/revalidate).
# Must equal REVALIDATE_SECRET in backend/.env, whose
# FRONTEND_REVALIDATE_URL must point at <this site>/api/revalidate.
REVALIDATE_SECRET=

# Optional: display name used in titles and the admin UI (src/lib/brand.js).
# NEXT_PUBLIC_SITE_NAME=ZFK Accountants
